AUTH_SECRET=
APP_URL=http://127.0.0.1:4173
CLOUDFLARE_WEB_ANALYTICS_TOKEN=
AUTH_SERVER_PORT=4180

# LigaGundam partner pilot. Keep the relationship as "pilot" until a signed
# affiliate agreement and its approved deeplink format are available.
VITE_LIGAGUNDAM_PARTNER_STATUS=pilot
# Server-side only. The approved template must include {{destination}}, which
# will be replaced with the URL-encoded LigaGundam card listing.
LIGAGUNDAM_AFFILIATE_DEEPLINK_TEMPLATE=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

DATABASE_URL=file:./data/gundam.db

# Hosted schedule editor: a comma-separated allowlist for the private
# ChatGPT-backed editor. Leave blank locally; never enable the local-only
# development override in a hosted environment.
COMMUNITY_SCHEDULE_ADMIN_EMAILS=
COMMUNITY_SCHEDULE_ADMIN_IDS=

# Optional: public ExBurst Gundam deck import settings.
# Leave blank to use the bundled public ExBurst endpoint/key extracted from their public app.
EXBURST_SUPABASE_URL=
EXBURST_SUPABASE_ANON_KEY=
EXBURST_GUNDAM_DECKLISTS_TABLE=gundam_decklists

# Server-side provider for the FORJA competitive assistant.
# Gemini is preferred and offers a free tier. Never expose this value through VITE_* variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Keep false in public environments. Setting true grants all hosted accounts remote Forge access.
FORGE_AI_ALLOW_FREE=false

# Optional legacy alternative. Used only when GEMINI_API_KEY is empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Future Patreon v2 entitlement connector. Keep empty until a published creator
# campaign and OAuth client exist. Store real values only as hosted secrets.
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_CAMPAIGN_ID=
PATREON_SUPPORTER_TIER_ID=
PATREON_NEWTYPE_TIER_ID=
PATREON_MASTER_TIER_ID=
PATREON_REDIRECT_URI=
PATREON_WEBHOOK_SECRET=
