{
  "name": "tcg-tactical-database",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "npm run data:build && node scripts/build_public_payloads.mjs && vite build",
    "build:public-data": "node scripts/build_public_payloads.mjs",
    "data:update": "node scripts/data-engine.mjs update",
    "data:migrate": "node scripts/data-engine.mjs migrate",
    "data:validate": "node scripts/data-engine.mjs validate",
    "data:build": "node scripts/data-engine.mjs build",
    "data:export": "node scripts/data-engine.mjs export",
    "data:msa": "node scripts/collect-msa-public.mjs",
    "data:community": "node scripts/import-community-event.mjs",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "auth": "node server/authServer.mjs",
    "migrate:auth": "node scripts/apply_auth_migration.mjs",
    "start": "node server/authServer.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "vite": "^7.2.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {}
}
