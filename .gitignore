.env
.env.*
!.env.example
node_modules/
dist/
.scratch/
*.log
_backups/
# The general card/price cache remains local. Competitive data is a versioned,
# reproducible static datastore and must stay in Git.
data/*
!data/competitive/
!data/competitive/**
# Exports are reproducible operator outputs, not the versioned datastore.
data/competitive/exports/*
!data/competitive/exports/.gitkeep
outputs/
.local/
**/__pycache__/
